# Required — your Databricks workspace URL
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Required for service-principal auth (not needed when running as a Databricks App)
# DATABRICKS_CLIENT_ID=your-client-id
# DATABRICKS_CLIENT_SECRET=your-client-secret

# Optional — SQL warehouse for analytics queries
# DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# Optional — OpenTelemetry collector endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Server settings
DATABRICKS_APP_PORT=8000
