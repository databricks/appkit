command: ['{{or .packageManager "pnpm"}}', 'run', 'start']
# Databricks Apps counts the deploy as succeeded only once /health answers 2xx,
# within 300 s. AppKit serves /health after every plugin's setup, migrations
# included, so a failed start fails the deploy instead of passing after 2 s.
health_check:
  path: /health
{{- if or .appEnv .plugins.database}}
env:
{{- end}}
{{- if .appEnv}}
{{.appEnv}}
{{- end}}
{{- if .plugins.database}}
  - name: APPKIT_DB_MIGRATE_ON_START
    value: "true"
{{- end}}
