{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": true,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "**/.claude",
    "**/*.md",
    "**/*.mdx",
    "**/*.html",
    "**/*.yaml",
    "**/*.yml",
    "**/dist",
    "**/tmp",
    "**/*.d.ts",
    "**/build",
    "**/coverage",
    "packages/appkit-ui/src/react/ui",
    "**/routeTree.gen.ts",
    "docs/.docusaurus",
    "**/*.gen.css",
    "**/*.gen.ts",
    "**/typedoc-sidebar.ts",
    "**/template",
    "**/appkit-types/metric-views.ts"
  ]
}
