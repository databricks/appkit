{
  "name": "@databricks/app-analytics",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Browser experience telemetry for Databricks Apps, encoded as OpenTelemetry.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.0.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/databricks/appkit.git",
    "directory": "packages/app-analytics"
  },
  "keywords": [
    "databricks",
    "web-vitals",
    "analytics",
    "telemetry",
    "opentelemetry",
    "rum",
    "clickstream",
    "apps"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DCO"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "development": "./src/react/index.tsx",
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:package": "tsdown --config tsdown.config.ts",
    "build:watch": "tsdown --config tsdown.config.ts --watch",
    "clean:full": "rm -rf dist node_modules tmp",
    "clean": "rm -rf dist tmp",
    "dist": "tsx ../../tools/dist-standalone-package.ts",
    "tarball": "rm -rf tmp && pnpm dist && npm pack ./tmp --pack-destination ./tmp",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-vitals": "6.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "react": "19.2.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./react": {
        "import": {
          "types": "./dist/react/index.d.ts",
          "default": "./dist/react/index.js"
        },
        "require": {
          "types": "./dist/react/index.d.cts",
          "default": "./dist/react/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
