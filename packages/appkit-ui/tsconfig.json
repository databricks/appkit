{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // Sources from shared are compiled in.
    "rootDir": "..",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/*": ["./src/*"],
      "@databricks/appkit-ui/*": ["./src/*"],
      "shared": ["../shared/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
