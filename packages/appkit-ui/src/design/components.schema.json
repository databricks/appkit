{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data-appkit blocks",
  "description": "Props for <script type=\"application/json\" data-appkit=\"<Component>\">…</script> blocks in drafts. Each block is one JSON object matching its component's schema. A block with data-src=\"mock#<key>\" takes its data from drafts/mock.json (one JSON object, keyed by name): an array becomes the block's data (rows for a DataTable), an object is merged into its props. Props written in the block win; the block may hold no JSON at all.",
  "components": {
    "BarChart": {
      "description": "Bar chart (appkit-ui BarChart).",
      "schema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "required": ["x", "series"],
            "properties": {
              "x": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": ["string", "number"]
                },
                "description": "Category or x-axis labels."
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "data"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": ["number", "null"]
                      },
                      "description": "One value per x label (same length as x)."
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Rows, e.g. [{\"day\":\"Mon\",\"trips\":12}]."
              },
              "xKey": {
                "type": "string",
                "description": "Row field for x / categories. Auto-detected."
              },
              "yKey": {
                "type": ["string", "array"],
                "items": {
                  "type": "string"
                },
                "description": "Row field(s) for values. Auto-detected."
              }
            }
          }
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Heading shown above the chart. Leave it out when the block's container already has its own heading."
          },
          "height": {
            "type": "number",
            "description": "Height in pixels. By default the chart fills its container's height (at least 160px)."
          },
          "showLegend": {
            "type": "boolean",
            "description": "Show the legend."
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Series colors (CSS colors); defaults to the theme palette."
          },
          "ariaLabel": {
            "type": "string"
          },
          "orientation": {
            "enum": ["vertical", "horizontal"],
            "description": "Default vertical."
          },
          "stacked": {
            "type": "boolean"
          }
        }
      },
      "example": {
        "title": "Trips per day",
        "x": ["Mon", "Tue", "Wed"],
        "series": [
          {
            "name": "Trips",
            "data": [12, 19, 7]
          }
        ]
      }
    },
