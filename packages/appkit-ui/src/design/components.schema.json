          }
        }
      },
      "example": {
        "title": "Signups",
        "data": [
          {
            "week": "W1",
            "signups": 40
          },
          {
            "week": "W2",
            "signups": 55
          }
        ],
        "xKey": "week",
        "yKey": "signups"
      }
    },
    "PieChart": {
