    "DataTable": {
      "description": "Static table (appkit-ui Table).",
      "schema": {
        "type": "object",
        "required": ["columns", "rows"],
        "properties": {
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Field name, also used as the header."
                },
                {
                  "type": "object",
                  "required": ["key"],
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "Row field."
                    },
                    "label": {
                      "type": "string",
                      "description": "Header; defaults to key."
                    }
                  }
                }
              ]
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "description": "Keyed by column key."
                },
                {
                  "type": "array",
                  "description": "Values in column order."
                }
              ]
            }
          }
        }
      },
      "example": {
        "columns": [
          {
            "key": "city",
            "label": "City"
          },
          {
            "key": "trips",
            "label": "Trips"
          }
        ],
        "rows": [
          {
            "city": "Madrid",
            "trips": 320
          },
          ["Rome", 280]
        ]
      }
    },
    "KpiCard": {
      "description": "KPI card (appkit-ui Card).",
      "schema": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": ["string", "number"]
          },
          "delta": {
            "type": ["string", "number"],
            "description": "E.g. \"+4% vs last week\"."
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "example": {
        "label": "Total trips",
        "value": "1,204",
        "delta": "+4% vs last week"
      }
    }
  }
