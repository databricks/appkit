      "example": {
        "title": "Revenue",
        "x": ["Jan", "Feb", "Mar"],
        "series": [
          {
            "name": "2025",
            "data": [10, 14, 13]
          },
          {
            "name": "2026",
            "data": [12, 18, 21]
          }
        ]
