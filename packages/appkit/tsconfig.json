{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // Sources from shared, lakebase, and tools are compiled in.
    "rootDir": "../..",
    "paths": {
      "@/*": ["./src/*"],
      "@tools/*": ["../../tools/*"],
      "shared": ["../../packages/shared/src"],
      "@databricks/lakebase": ["../../packages/lakebase/src"],
      "@databricks/appkit": ["./src/index.ts"],
      "@databricks/appkit/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
