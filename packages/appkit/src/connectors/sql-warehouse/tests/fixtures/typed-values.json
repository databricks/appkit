{
  "source": "Statement Execution API on a serverless PRO SQL warehouse (session time zone America/Los_Angeles), captured 2026-11-10",
  "statement": "SELECT\n  CAST(id AS INT) AS id,\n  IF(id % 5 = 4, NULL, CAST(id AS BIGINT) * 1000000000007) AS big,\n  IF(id % 5 = 4, NULL, CAST(id % 100 AS TINYINT)) AS tiny,\n  IF(id % 5 = 4, NULL, CAST(id AS SMALLINT)) AS small,\n  IF(id % 5 = 4, NULL, CAST(id * 1.5 AS DOUBLE)) AS amount,\n  IF(id % 5 = 4, NULL, CAST(id * 0.25 AS FLOAT)) AS ratio,\n  IF(id % 5 = 4, NULL, CAST((id * 101 - 50) / 100.0 AS DECIMAL(10, 2))) AS price,\n  IF(id % 5 = 4, NULL, DATE_ADD(DATE'2026-01-01', CAST(id AS INT))) AS day,\n  IF(id % 5 = 4, NULL, TIMESTAMPADD(HOUR, id, TIMESTAMP'2026-01-01 10:00:00')) AS ts,\n  IF(id % 5 = 4, NULL, TIMESTAMPADD(HOUR, id, TIMESTAMP_NTZ'2026-01-01 10:00:00')) AS ts_ntz,\n  IF(id % 5 = 4, NULL, TIMESTAMPADD(MICROSECOND, id, TIMESTAMP'2026-01-01 10:00:00.123456')) AS ts_micro,\n  IF(id % 5 = 4, NULL, CONCAT('{\"order_id\": 1234567890123456789', CAST(id % 10 AS STRING), ', \"tags\": [1, 2]}')) AS payload,\n  IF(id % 5 = 4, NULL, id % 2 = 0) AS flag,\n  CASE WHEN id % 7 = 3 THEN NULL ELSE CONCAT('row-', CAST(id AS STRING)) END AS label,\n  IF(id % 5 = 4, NULL, ARRAY(id, id + 1)) AS arr,\n  IF(id % 5 = 4, NULL, id) AS dup,\n  IF(id % 5 = 4, NULL, id + 1) AS dup\nFROM range(0, 30) AS t(id)\nORDER BY id",
