{
  "$schema": "https://databricks.github.io/appkit/schemas/plugin-manifest.schema.json",
  "name": "jobs",
  "displayName": "Jobs Plugin",
  "description": "Run and monitor Databricks jobs and pipelines",
  "resources": {
    "required": [
      {
        "type": "job",
        "alias": "Job",
        "resourceKey": "job",
        "description": "Databricks Job to trigger and monitor. Job IDs configured via plugin config.",
        "permission": "CAN_MANAGE_RUN",
        "fields": {
          "id": {
            "env": "DATABRICKS_JOB_ID",
            "description": "Default Job ID"
          }
        }
      }
    ],
    "optional": []
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "jobs": {
          "type": "object",
          "description": "Map of alias names to Databricks Job IDs",
          "additionalProperties": {
            "type": "number"
          }
        },
        "timeout": {
          "type": "number",
          "default": 600000,
          "description": "Run polling timeout in ms. Set to 0 for indefinite."
        }
      }
    }
  }
}
