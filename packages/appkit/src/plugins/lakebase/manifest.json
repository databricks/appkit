{
  "$schema": "https://databricks.github.io/appkit/schemas/plugin-manifest.schema.json",
  "name": "lakebase",
  "displayName": "Lakebase",
  "description": "SQL query execution against Databricks Lakebase Autoscaling",
  "hidden": false,
  "resources": {
    "required": [
      {
        "type": "postgres",
        "alias": "Postgres",
        "resourceKey": "postgres",
        "description": "Lakebase Postgres database for persistent storage",
        "permission": "CAN_CONNECT_AND_CREATE",
        "fields": {
          "endpoint": {
            "env": "LAKEBASE_ENDPOINT",
            "description": "Lakebase endpoint path",
            "bundleIgnore": true
          }
        }
      }
    ],
    "optional": []
  }
}
