{
  "$schema": "https://databricks.github.io/appkit/schemas/plugin-manifest.schema.json",
  "name": "omnigent",
  "displayName": "Omnigent Plugin",
  "description": "Embedded Omnigent agent runtime: Claude Agent SDK, Codex, Pi and OpenAI Agents SDK harnesses through Unity AI Gateway",
  "stability": "beta",
  "resources": {
    "required": [],
    "optional": []
  },
  "scaffolding": {
    "rules": {
      "must": [
        "Add pyproject.toml (python >=3.12,<3.13) with omnigent[databricks] and a uv.lock that uses public PyPI",
        "Add harness CLIs to package.json: @anthropic-ai/claude-code, @openai/codex, @earendil-works/pi-coding-agent",
        "Start the app with node, not npm run, so SIGTERM reaches the plugin and it can stop its child processes"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "description": "System instructions for every session"
        },
        "harnesses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Harnesses users may pick"
        },
        "defaultHarness": {
          "type": "string"
        },
        "defaultModel": {
          "type": "string"
        }
      }
    }
  }
}
