{
  "$schema": "https://databricks.github.io/appkit/schemas/plugin-manifest.schema.json",
  "name": "files",
  "displayName": "Files Plugin",
  "description": "File operations against Databricks Volumes and Unity Catalog",
  "resources": {
    "required": [
      {
        "type": "volume",
        "alias": "volume",
        "resourceKey": "volume",
        "description": "Unity Catalog Volume for file storage",
        "permission": "WRITE_VOLUME",
        "fields": {
          "path": {
            "env": "DATABRICKS_DEFAULT_VOLUME",
            "description": "Volume path (e.g. /Volumes/catalog/schema/volume_name)"
          }
        }
      }
    ],
    "optional": []
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "number",
          "default": 30000,
          "description": "File operation timeout in milliseconds"
        }
      }
    }
  }
}
