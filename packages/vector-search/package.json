{
  "name": "@databricks/appkit-vector-search",
  "version": "0.1.0",
  "description": "Vector Search plugin for Databricks Appkit",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
