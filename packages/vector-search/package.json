    "@testing-library/react": "^15.0.0",
    "@types/express": "^4.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "jsdom": "^24.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "supertest": "^7.2.2",
