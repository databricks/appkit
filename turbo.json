{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DEBUG"],
  "ui": "tui",
  "tasks": {
    "proto:generate": {
      "inputs": ["proto/**/*.proto", "proto/buf.gen.yaml"],
      "outputs": ["packages/shared/src/proto/**"],
      "cache": true
    },
    "build:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
