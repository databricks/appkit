{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": [
    "packages/shared",
    "packages/lakebase",
    "apps/**",
    "docs"
  ],
  "workspaces": {
    "packages/appkit": {
      "ignoreDependencies": [
        "@databricks/langchainjs",
        "@langchain/core",
        "@langchain/langgraph",
        "@langchain/mcp-adapters"
      ]
    },
    "packages/appkit-ui": {}
  },
  "ignore": [
    "**/*.generated.ts",
    "**/*.example.tsx",
    "template/**",
    "tools/**",
    "docs/**"
  ],
  "ignoreBinaries": ["tarball"]
}
