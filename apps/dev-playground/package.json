{
  "name": "dev-playground",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "appkit": {
    "autoMigrate": false
  },
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "dev:inspect": "NODE_ENV=development tsx --inspect --tsconfig ./tsconfig.server.json ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:integration:headed": "playwright test --headed",
    "clean": "rm -rf client/dist dist"
  },
  "dependencies": {
    "@databricks/appkit": "0.61.1",
    "@databricks/appkit-ui": "0.61.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.1",
    "html2canvas": "1.4.1",
    "html2canvas-pro": "2.0.2",
    "lucide-react": "0.546.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.18.0",
    "recharts": "3.4.1",
    "reflect-metadata": "0.2.2",
    "sequelize": "6.37.7",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "20.19.21",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "dotenv": "16.6.1",
    "postcss": "8.5.6",
    "shiki": "3.15.0",
    "tailwindcss": "4.1.17",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
